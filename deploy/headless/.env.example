# Copy to .env. AI keys are entered in the app (setup wizard or Settings), not here.

# AnkiWeb account this collection syncs with. Optional — leave blank and sign
# in to AnkiWeb in the app instead. When set, these take precedence over a UI
# login and the password is never written to disk.
ANKIWEB_USERNAME=
ANKIWEB_PASSWORD=

# Published address/port (default 127.0.0.1:8080). AnkiNote has no login:
# read "Before you open it to other devices" in deploy/README.md first.
# ANKINOTE_PUBLISH=127.0.0.1:8080

# Image and tag (default ghcr.io/ankinote-ai/ankinote:latest). Pin a minor
# version to get fixes but not new features.
# ANKINOTE_IMAGE=ghcr.io/ankinote-ai/ankinote:1.1
